# Optional remote AI endpoints (fallback before the on-device iOS build exists).
# Copy this file to `.env`, fill in URLs, and restart `expo start`. Empty = disabled.
# These are EXPO_PUBLIC_* so they're inlined into the app at build time.

# Background removal ("beautify"). Point at your home server (scripts/beautify-server.py)
# or any cloud API that accepts { image } and returns { image }.
# Example (home machine on your LAN):
# EXPO_PUBLIC_BEAUTIFY_URL=http://192.168.1.50:7000/remove
EXPO_PUBLIC_BEAUTIFY_URL=

# Stylist text generation. Point at a small proxy/server that accepts { prompt } and
# returns { text } (e.g. a local Ollama wrapper or a Claude API proxy you run).
# EXPO_PUBLIC_GENERATE_URL=http://192.168.1.50:7001/generate
EXPO_PUBLIC_GENERATE_URL=
